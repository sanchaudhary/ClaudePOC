<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>CSAT Phone Survey — SCRUM-24. Quick Action flow for capturing post-call patient satisfaction surveys from Account records.</description>
    <environments>Default</environments>
    <interviewLabel>CSAT Phone Survey {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CSAT Phone Survey</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>DefaultMode</runInMode>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <choices>
        <name>choiceVerySatisfied</name>
        <choiceText>Very Satisfied</choiceText>
